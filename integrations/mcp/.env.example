# Read-only is the default. Set both variables to enable writes.
REFERRALRAIL_PRIVATE_KEY=0x<private-key>
REFERRALRAIL_WRITE_ENABLED=false

# Optional v2 campaign deployment. V2 tools are registered only when both are set.
REFERRALRAIL_V2_ADDRESS=0x<referralrail-v2-address>
OUTCOMEJUDGE_V2_ADDRESS=0x<outcomejudge-v2-address>
